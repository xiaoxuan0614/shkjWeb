{
  "name": "shouhui-website-vue",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-gallery.js && vite",
    "build": "node scripts/generate-gallery.js && vite build && vite build --ssr src/entry-server.js --outDir .seo-dist --emptyOutDir && node scripts/prerender.mjs && node scripts/check-seo.mjs",
    "build:test": "VITE_BASE_PATH=/v2/ npm run build",
    "build:client": "node scripts/generate-gallery.js && vite build",
    "seo:check": "node scripts/check-seo.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.18.1",
    "element-plus": "^2.14.3",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-sitemap": "^0.8.2"
  }
}
